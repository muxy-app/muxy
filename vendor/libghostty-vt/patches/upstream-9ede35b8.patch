+    /// #       1 => (&[255, 0, 0, 255], 50),
+    /// #       _ => (&[0, 0, 255, 255], 100),
+    /// #   };
+    /// #   assert_eq!((frame.data, frame.gap_ms), expected);
+    /// }
+    /// # Ok(())
+    /// # }
+    /// ```
