+    // Null for a frame that doesn't exist (including number 0) and
+    // for one whose pixels are pending, like the data_ptr getter.
+    const data = image.frameData(number) orelse return .no_value;
+    out.* = .{
+        .data = data.ptr,
+        .data_len = data.len,
+        // Frames are numbered from 1, gaps are indexed from 0.
