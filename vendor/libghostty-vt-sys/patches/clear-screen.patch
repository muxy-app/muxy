+pub fn clear_screen(terminal_: Terminal) callconv(lib.calling_conv) bool {
+    const t: *ZigTerminal = (terminal_ orelse return false).terminal;
+    if (t.screens.active_key == .alternate) return false;
+
+    const redraw_prompt = t.cursorIsAtPrompt();
+    t.screens.active.clearSelection();
+    t.eraseDisplay(.scrollback, false);
+    if (redraw_prompt) {
+        t.eraseDisplay(.complete, false);
+        // Erasing the display at a prompt can move its contents into history.
+        t.eraseDisplay(.scrollback, false);
+    } else {
+        if (t.screens.active.cursor.y > 0) {
+            t.screens.active.eraseActive(t.screens.active.cursor.y - 1);
+        }
+        if (comptime build_options.kitty_graphics) {
+            t.screens.active.kitty_images.delete(
+                t.screens.active.alloc,
+                t,
+                .{ .all = true },
+            );
+        }
+    }
+    return redraw_prompt;
