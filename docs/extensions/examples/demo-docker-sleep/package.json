{
  "name": "demo-docker-sleep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const f of ['background.js','package.json'])fs.copyFileSync(f,'dist/'+f)\""
  },
  "muxy": {
    "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
    "description": "Stops a worktree's docker compose stack when all its terminals fall asleep and starts it again when the worktree wakes.",
    "background": "background.js",
    "permissions": ["commands:exec", "notifications:write"],
    "events": ["worktree.offline"]
  }
}
