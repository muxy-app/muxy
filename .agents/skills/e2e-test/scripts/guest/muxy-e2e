cmd_image_fixture() {
  # Inline image test files: a 160x80 PNG with red, green, blue and yellow
  # quarters, a 160x84 Sixel with purple, cyan, orange and white quarters, and
  # ~/e2e/images/show, which prints them with text markers around each image.
  local dir="$FIXTURES/images"
  mkdir -p "$dir"
  printf '%s' '' | base64 --decode > "$dir/photo.png" || die "could not write photo.png"
  printf '%s' '"1;1;160;84#1;2;60;20;80#2;2;10;80;80#3;2;100;55;0#4;2;100;100;100#1!80~#2!80~-#1!80~#2!80~-#1!80~#2!80~-#1!80~#2!80~-#1!80~#2!80~-#1!80~#2!80~-#1!80~#2!80~-#3!80~#4!80~-#3!80~#4!80~-#3!80~#4!80~-#3!80~#4!80~-#3!80~#4!80~-#3!80~#4!80~-#3!80~#4!80~-' > "$dir/sixel.txt"
  # A 160x80 GIF of four frames, two seconds each: red, green, blue, yellow.
  printf '%s' '' | base64 --decode > "$dir/anim.gif" || die "could not write anim.gif"
  cat > "$dir/show" <<'SHOW'
#!/bin/bash
# Prints test images. Usage: show kitty|kitty-file|kitty-temp|iterm|sixel|fifo|da1|iterm-gif|kitty-gif|kitty-anim
DIR="$(cd "$(dirname "$0")" && pwd)"
b64() { base64 < "$1" | tr -d '\n'; }
path64() { printf '%s' "$1" | base64 | tr -d '\n'; }
case "${1:-}" in
  kitty) printf 'KITTY-BEFORE\n\033_Ga=T,f=100,c=16;%s\033\\\nKITTY-AFTER\n' "$(b64 "$DIR/photo.png")" ;;
  kitty-file) printf 'FILE-BEFORE\n\033_GX=1,a=T,f=100,t=f,c=16;%s\033\\\nFILE-AFTER\n' "$(path64 "$DIR/photo.png")" ;;
  kitty-temp)
    tmp="${TMPDIR:-/tmp}"; tmp="${tmp%/}/tty-graphics-protocol-muxy-e2e.png"
    cp "$DIR/photo.png" "$tmp"
    printf 'TEMP-BEFORE\n\033_Ga=T,f=100,t=t,c=16;%s\033\\\nTEMP-AFTER\n' "$(path64 "$tmp")"
    sleep 1
    if [ -e "$tmp" ]; then echo TEMP-KEPT; else echo TEMP-DELETED; fi ;;
  iterm) printf 'ITERM-BEFORE\n\033]1337;File=inline=1;width=16:%s\007\nITERM-AFTER\n' "$(b64 "$DIR/photo.png")" ;;
  sixel) printf 'SIXEL-BEFORE\n\033Pq%s\033\\\nSIXEL-AFTER\n' "$(cat "$DIR/sixel.txt")" ;;
  iterm-gif) printf 'IGIF-BEFORE\n\033]1337;File=inline=1;width=16:%s\007\nIGIF-AFTER\n' "$(b64 "$DIR/anim.gif")" ;;
