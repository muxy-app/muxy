cmd_launch_without_muxy() {
  test -f "$SHARE/managed" || die "not a prepared Muxy test guest"
  [ -z "$(app_pid)" ] || die "quit the app first"
  rm -f "$HOME/.local/bin/muxy" "$HOME/.local/bin/.muxy-cli-link.json"
  mkdir -p "$SHARE" "$MUXY_DIR"
  printf '\n==== launch without muxy %s\n' "$(date)" >> "$APP_LOG"
  MUXY_E2E_HIDE_CLI=1 nohup "$HOME/.local/bin/muxy-vm-run" >> "$APP_LOG" 2>&1 < /dev/null &
  local i
  for i in $(seq 1 60); do
    sleep 0.5
    if [ -n "$(app_pid)" ] && muxy server status >/dev/null 2>&1; then
      sleep 3
      echo "app running without muxy on its PATH: pid $(app_pid)"
      return 0
    fi
  done
  die "the app did not start within 30 seconds"
}

cmd_info() {
  if [ "$OS" = Darwin ]; then
    echo "os: macOS $(sw_vers -productVersion) ($(sw_vers -buildVersion)) $(uname -m)"
  else
    echo "os: $(. /etc/os-release; echo "$PRETTY_NAME") $(uname -m)"
    echo "webkitgtk: $(dpkg-query -W -f '${Version}' libwebkit2gtk-4.1-0 2>/dev/null)"
  fi
  echo "session: $(session_type)"
  echo "shell: $SHELL"
  local binary
  for binary in muxy-app muxy muxy-server; do
    echo "$binary: $("$BIN/$binary" --build-info 2>&1)"
  done
}

cmd_logs() {
  echo "### app.log (last 80 lines)"; tail -80 "$APP_LOG" 2>/dev/null
  echo "### server.log (last 80 lines)"; tail -80 "$MUXY_DIR/server.log" 2>/dev/null
  local file
  for file in "$MUXY_DIR"/app-diagnostics-*.log; do
    [ -f "$file" ] || continue
    echo "### $(basename "$file") (last 40 lines)"; tail -40 "$file"
  done
  echo "### processes"
  ps -axo pid,etime,comm | grep -E 'muxy|sleep|python3' | grep -v grep
}

cmd_running() {
  local matches
  matches="$(ps -axo pid,command | grep -F -- "$1" | grep -v -e muxy-e2e -e 'grep -F')"
  [ -n "$matches" ] || { echo "no process matches: $1"; return 1; }
  echo "$matches"
}

cmd_config() {
  local file="$MUXY_DIR/$1"
  [ -f "$file" ] || die "no $1 in the test profile"
  cat "$file"
}

cmd_tui() {
  if [ $# -eq 0 ]; then
    MUXY_DIR="$FIXTURES/tui-profile" muxy
  else
    MUXY_DIR="$FIXTURES/tui-profile" run_muxy "$@"
  fi
}

cmd_tui_primary() {
  export MUXY_DIR="$FIXTURES/tui-profile"
  echo $$ > "$FIXTURES/tui-primary.pid"
  exec muxy
}

cmd_tui_record() {
  export MUXY_DIR="$FIXTURES/tui-profile"
  local command='echo $$ > "$HOME/e2e/tui-primary.pid"; exec muxy'
  if [ "$OS" = Darwin ]; then
    script -q -F "$FIXTURES/tui.typescript" sh -c "$command"
  else
    script -q -f -c "$command" "$FIXTURES/tui.typescript"
  fi
}

cmd_tui_idle() {
  local before after delta
  before="$(wc -c < "$FIXTURES/tui.typescript")" || return 1
  sleep 10
  after="$(wc -c < "$FIXTURES/tui.typescript")" || return 1
  delta=$((after - before))
  echo "idle bytes in 10 seconds: $delta (limit 320); before=$before after=$after"
  [ "$delta" -le 320 ]
}

cmd_tui_signal() {
  local pid parent
  pid="$(cat "$FIXTURES/tui-primary.pid")" || return 1
  case "$1" in
    suspend) kill -TSTP "$pid" ;;
    resume)
      parent="$(ps -p "$pid" -o ppid= | tr -d ' ')"
      case "$(ps -p "$parent" -o comm=)" in
        *script) kill -CONT "$parent" ;;
      esac
      kill -CONT "$pid"
      ;;
    *) die "usage: tui-signal suspend|resume" ;;
  esac
  sleep 1
  ps -o pid=,stat=,comm= -p "$pid"
}

cmd_lines() {
  local file
  file="$(expand_home "$1")"
  [ -f "$file" ] || { echo 0; return; }
  wc -l < "$file" | tr -d ' '
}

cmd_git() {
  local args=() arg directory
  directory="$(expand_home "$1")"
  shift
  for arg in "$@"; do args+=("$(expand_home "$arg")"); done
  git -C "$directory" "${args[@]}"
}

cmd_file() {
  local file
  file="$(expand_home "$1")"
  if [ -f "$file" ]; then cat "$file"; else echo "no such file: $1"; fi
}

cmd_exists() {
  if [ -e "$(expand_home "$1")" ]; then echo yes; else echo no; fi
}

# Deletes a folder behind Muxy's back. Only the test's own folders qualify.
cmd_rm_tree() {
  local path
  path="$(expand_home "$1")"
  case "$path" in
    "$FIXTURES"/*|"$HOME/.muxy/worktrees"/*) rm -rf "$path" && echo "deleted $path" ;;
    *) die "rm-tree only deletes inside ~/e2e or ~/.muxy/worktrees" ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: muxy-e2e <command> [arguments]      (guest side; on the host use: e2e g <vm> <command>)

