cmd_ime_fixture() {
  test -f "$SHARE/managed" || die "not a managed guest"
  if [ "$OS" = Darwin ]; then
    cat > "$SHARE/select-ime.c" <<'EOF'
#include <Carbon/Carbon.h>
#include <stdio.h>
#include <string.h>
int main(int argc, char **argv) {
    const char *target = argc > 1 && strcmp(argv[1], "off") == 0
        ? "com.apple.keylayout.US" : "com.apple.inputmethod.SCIM.ITABC";
    CFArrayRef sources = TISCreateInputSourceList(NULL, true);
    for (CFIndex i = 0; i < CFArrayGetCount(sources); i++) {
        TISInputSourceRef source = (TISInputSourceRef)CFArrayGetValueAtIndex(sources, i);
        CFStringRef id = TISGetInputSourceProperty(source, kTISPropertyInputSourceID);
        if (id && CFStringCompare(id, CFSTR("com.apple.inputmethod.SCIM"), 0) == kCFCompareEqualTo) {
            printf("enable parent: %d\n", (int)TISEnableInputSource(source));
        }
    }
    CFRelease(sources);
    sources = TISCreateInputSourceList(NULL, true);
    for (CFIndex i = 0; i < CFArrayGetCount(sources); i++) {
        TISInputSourceRef source = (TISInputSourceRef)CFArrayGetValueAtIndex(sources, i);
        CFStringRef id = TISGetInputSourceProperty(source, kTISPropertyInputSourceID);
        char name[256];
        if (id && CFStringGetCString(id, name, sizeof(name), kCFStringEncodingUTF8)
                && strcmp(name, target) == 0) {
            TISEnableInputSource(source);
            OSStatus status = TISSelectInputSource(source);
            printf("input source: %s, status: %d\n", name, (int)status);
            CFRelease(sources);
            return status != noErr;
        }
    }
    CFRelease(sources);
    fprintf(stderr, "input source unavailable: %s\n", target);
    return 1;
}
EOF
    clang "$SHARE/select-ime.c" -framework Carbon -o "$SHARE/select-ime" || return
    "$SHARE/select-ime" off
    return
  fi
  linux_display_env
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  if ! dpkg-query -W ibus-libpinyin >/dev/null 2>&1; then
    sudo -n apt-get -qq update && sudo -n apt-get -qq install -y ibus-libpinyin || return
  fi
  gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('ibus', 'libpinyin')]"
  ibus restart
  sleep 3
  ibus list-engine | grep libpinyin || return
  ibus engine xkb:us::eng
  touch "$SHARE/ime-fixture"
}

cmd_ime_mode() {
  test -f "$SHARE/managed" || die "not a managed guest"
  if [ "$OS" = Darwin ]; then
    "$SHARE/select-ime" "$1"
    return
  fi
  linux_display_env
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  if [ "$1" = off ]; then ibus engine xkb:us::eng; else ibus engine libpinyin; fi
  ibus engine
}


