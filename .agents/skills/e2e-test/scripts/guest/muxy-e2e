#!/bin/bash
# Guest-side helper for Muxy E2E runs. Installed by `e2e up` as ~/.local/bin/muxy-e2e.
# Works with macOS's bash 3.2: no associative arrays or mapfile.
set -uo pipefail

export MUXY_DIR="$HOME/.local/state/muxy-vm"
BIN="$HOME/.cache/muxy-vm/target/debug"
export MUXY_SERVER_BIN="$BIN/muxy-server"
export PATH="$BIN:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
SHARE="$HOME/.local/share/muxy-vm"
APP_LOG="$SHARE/app.log"
FIXTURES="$HOME/e2e"
HTTP_PORT=8765
OS="$(uname -s)"

die() { echo "muxy-e2e: $*" >&2; exit 1; }

session_type() {
  if [ "$OS" = Darwin ]; then echo macos; return; fi
  loginctl show-session "$(loginctl show-user "$(id -u)" -p Display --value)" -p Type --value
}

linux_display_env() {
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ "$(session_type)" = wayland ]; then
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
  else
    export DISPLAY="${DISPLAY:-:0}"
  fi
}

# Steps single-quote paths like '~/e2e/beta' so the host shell keeps them; expand them here.
expand_home() {
  case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s' "$HOME/${1#\~/}" ;; *) printf '%s' "$1" ;; esac
}

run_muxy() {
  local args=() arg
  for arg in "$@"; do args+=("$(expand_home "$arg")"); done
  muxy "${args[@]}"
}

app_pid() { pgrep -x muxy-app | head -1; }

live_ids() { muxy session list --json 2>/dev/null | jq -r '.[] | select(.status == "Live") | .id'; }

# read-screen returns the last 50 rows by default, which misses the top of a taller window.
screen_of() { muxy session read-screen "$1" --lines 500 2>/dev/null | grep -v '^[[:space:]]*$'; }

project_name() {
  muxy project list --json 2>/dev/null | jq -r --arg id "$1" '.[] | select(.id == $id) | .name' | head -1
}

cmd_launch() {
  if [ -n "$(app_pid)" ]; then echo "app already running: pid $(app_pid)"; return 0; fi
  mkdir -p "$SHARE" "$MUXY_DIR"
  printf '\n==== launch %s\n' "$(date)" >> "$APP_LOG"
  if [ -f "$SHARE/ime-fixture" ] && [ "$OS" = Linux ]; then export XMODIFIERS=@im=ibus; fi
  nohup "$HOME/.local/bin/muxy-vm-run" >> "$APP_LOG" 2>&1 < /dev/null &
  local i
  for i in $(seq 1 60); do
    sleep 0.5
    if [ -n "$(app_pid)" ] && muxy server status >/dev/null 2>&1; then
      sleep 3
      echo "app running: pid $(app_pid); server: $(muxy server status 2>&1 | head -1)"
      return 0
    fi
  done
  tail -30 "$APP_LOG" >&2
  die "the app did not start within 30 seconds (log above)"
}

cmd_quit() {
  local pid i
  pid="$(app_pid)"
  [ -n "$pid" ] || { echo "app not running"; return 0; }
  kill -TERM "$pid"
  for i in $(seq 1 20); do
    sleep 0.5
    [ -z "$(app_pid)" ] && { echo "app quit"; return 0; }
  done
  kill -KILL "$pid" 2>/dev/null
  echo "app did not quit on SIGTERM; killed"
}

LINK_APP="$HOME/Applications/Muxy Beta E2E.app"
LINK_ENTRY="$HOME/.local/share/applications/muxy-e2e-links.desktop"

wait_for_app() {
  local i
  for i in $(seq 1 60); do
    sleep 0.5
    if [ -n "$(app_pid)" ] && muxy server status >/dev/null 2>&1; then
      sleep 3
      echo "app running: pid $(app_pid); server: $(muxy server status 2>&1 | head -1)"
      return 0
    fi
  done
  die "the app did not start within 30 seconds"
}

cmd_link_launch() {
  cmd_quit >/dev/null
  if [ "$OS" = Darwin ]; then
    rm -rf "$LINK_APP"
    mkdir -p "$LINK_APP/Contents/MacOS" "$MUXY_DIR"
    local binary
    for binary in muxy-app muxy muxy-server; do
      cp -c "$BIN/$binary" "$LINK_APP/Contents/MacOS/$binary" 2>/dev/null || cp "$BIN/$binary" "$LINK_APP/Contents/MacOS/$binary"
    done
    python3 - "$HOME/src/muxy/scripts" "$LINK_APP/Contents/Info.plist" "$MUXY_DIR" "$BIN" <<'PLIST' || die "could not write the bundle's Info.plist"
import plistlib
import sys
sys.path.insert(0, sys.argv[1])
import release
info = release.bundle_info("2.0.0-beta.1", "1")
info["LSEnvironment"] = {"MUXY_DIR": sys.argv[3], "MUXY_SERVER_BIN": sys.argv[4] + "/muxy-server",
                         "PATH": sys.argv[4] + ":/usr/bin:/bin:/usr/sbin:/sbin"}
with open(sys.argv[2], "wb") as output:
    plistlib.dump(info, output)
PLIST
    codesign --force --deep --sign - "$LINK_APP" >/dev/null 2>&1 || true
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$LINK_APP"
    printf '\n==== link-launch %s\n' "$(date)" >> "$APP_LOG"
    open "$LINK_APP" || die "could not open $LINK_APP"
    wait_for_app
    echo "muxy-beta:// links open $LINK_APP"
    return 0
  fi
  mkdir -p "$(dirname "$LINK_ENTRY")"
  cat > "$LINK_ENTRY" <<ENTRY
[Desktop Entry]
Type=Application
Name=Muxy Beta E2E
Exec="$HOME/.local/bin/muxy-vm-run" %U
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/muxy-beta;
ENTRY
  update-desktop-database -q "$(dirname "$LINK_ENTRY")" 2>/dev/null || true
  xdg-mime default "$(basename "$LINK_ENTRY")" x-scheme-handler/muxy-beta
  cmd_launch
  echo "muxy-beta:// links open $(xdg-mime query default x-scheme-handler/muxy-beta)"
}

cmd_open_link() {
  local url="$1"
  if [ "$OS" = Darwin ]; then
    open "$url" || die "open refused $url"
  else
    linux_display_env
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
    printf '\n==== open-link %s %s\n' "$url" "$(date)" >> "$APP_LOG"
    nohup xdg-open "$url" >> "$APP_LOG" 2>&1 < /dev/null &
  fi
  sleep 3
  echo "opened $url"
}

session_showing() {
  local text="$1" id matches=""
  for id in $(live_ids); do
    if screen_of "$id" | grep -qF -- "$text"; then matches="$matches $id"; fi
  done
  set -- $matches
  [ $# -eq 1 ] || die "expected one live terminal showing '$text', found $#"
  echo "$1"
}

cmd_open_session() {
  local link id="$1"
  case "$id" in
    ''|*[!0-9]*) id="$(session_showing "$1")" || exit 1; echo "session: $id" ;;
  esac
  if [ -n "${2:-}" ]; then
    link="$(muxy session link "$id" --split "$2")" || die "muxy session link failed"
  else
    link="$(muxy session link "$id")" || die "muxy session link failed"
  fi
  echo "link: $link"
  cmd_open_link "$link"
}

cmd_stop_all() {
  cmd_quit >/dev/null
  muxy server stop --force >/dev/null 2>&1 || true
  pkill -x muxy-server 2>/dev/null || true
  cmd_http_stop >/dev/null 2>&1 || true
  echo "app, server and helpers stopped"
}

cmd_fixtures() {
  rm -rf "$FIXTURES"
  mkdir -p "$FIXTURES/alpha/.muxy/layouts" "$FIXTURES/beta" "$FIXTURES/gamma/.muxy" "$FIXTURES/site"
  cat > "$FIXTURES/gamma/README.md" <<'EOF'
# gamma
Fixture repository for Muxy's worktree tests.
EOF
  cat > "$FIXTURES/gamma/.muxy/worktree.json" <<'EOF'
{
  "setup": ["echo setup-$MUXY_WORKTREE_BRANCH >> ~/e2e/hook-log.txt"],
  "teardown": ["echo teardown-$MUXY_WORKTREE_BRANCH >> ~/e2e/hook-log.txt"]
}
EOF
  (
    cd "$FIXTURES/gamma" && git init -q -b main && git add -A && git commit -qm "Initial fixture" \
      && git checkout -q -b topic && echo "only on topic" > topic.txt && git add -A \
      && git commit -qm "Topic work" && git checkout -q main
  ) || die "could not create the gamma git repository"
  cat > "$FIXTURES/alpha/README.md" <<'EOF'
# alpha
Fixture project for Muxy E2E tests.
EOF
  cat > "$FIXTURES/alpha/.muxy/layouts/trio.yaml" <<'EOF'
layout: horizontal
panes:
  - tab:
      name: left
      command: echo layout-left-$((40+2))
  - layout: vertical
    panes:
      - tab: echo layout-top-$((40+2))
      - tab:
          name: bottom
          command: echo layout-bottom-$((40+2))
EOF
  (cd "$FIXTURES/alpha" && git init -q -b main && git add -A && git commit -qm "Initial fixture") \
    || die "could not create the alpha git repository"
  printf 'beta notes\n' > "$FIXTURES/beta/notes.txt"
  cat > "$FIXTURES/site/index.html" <<'EOF'
<!doctype html>
<html><head><meta charset="utf-8"><title>E2E Home</title></head>
<body style="font-family: sans-serif; background: #fff7d6">
<h1 id="greeting">Hello from Muxy E2E</h1>
<p>Fixture page served from the guest.</p>
<input id="name" placeholder="Your name">
<button id="go" onclick="document.getElementById('out').textContent = 'Saved ' + document.getElementById('name').value">Save</button>
<p id="out"></p>
<a id="next" href="next.html">Go to the second page</a>
</body></html>
EOF
  cat > "$FIXTURES/site/next.html" <<'EOF'
<!doctype html>
<html><head><meta charset="utf-8"><title>E2E Second</title></head>
<body style="font-family: sans-serif; background: #d6f0ff"><h1>Second page reached</h1></body></html>
EOF
  echo "fixtures ready in $FIXTURES: alpha (git repo with .muxy/layouts/trio.yaml), beta, gamma (git repo with worktree hooks and a topic branch), site"
}

cmd_reset() {
  cmd_stop_all >/dev/null
  test -f "$SHARE/managed" || die "not a prepared Muxy test guest"
  rm -rf "$MUXY_DIR" "$HOME/.muxy/worktrees"
  # A fresh profile would open the welcome tour over everything; suites start past it.
  mkdir -p "$MUXY_DIR"
  printf '[appearance]\nonboarding_completed = true\n' > "$MUXY_DIR/settings.toml"
  cmd_clip_set "" >/dev/null 2>&1 || true
  cmd_fixtures
  cmd_launch
}

cmd_screens() {
  local id project
  for id in $(live_ids); do
    project="$(project_name "$(muxy session list --json | jq -r --arg id "$id" '.[] | select(.id == $id) | .project_id')")"
    echo "=== session $id (project: $project)"
    screen_of "$id"
  done
}

cmd_find() {
  local text="$1" id found=1 line
  for id in $(live_ids); do
    line="$(screen_of "$id" | grep -F -- "$text" | tail -1)"
    if [ -n "$line" ]; then echo "$id: $line"; found=0; fi
  done
  return $found
}

cmd_wait() {
  local text="$1" seconds="${2:-15}" i
  for i in $(seq 1 $((seconds * 2))); do
    cmd_find "$text" && return 0
    sleep 0.5
  done
  echo "not found on any live terminal screen after ${seconds}s: $text" >&2
  return 1
}

cmd_gone() {
  local text="$1" seconds="${2:-15}" i
  for i in $(seq 1 $((seconds * 2))); do
    cmd_find "$text" >/dev/null || { echo "gone: $text"; return 0; }
    sleep 0.5
  done
  echo "still on screen after ${seconds}s: $text" >&2
  return 1
}

cmd_clip_set() {
  if [ "$OS" = Darwin ]; then printf '%s' "$1" | pbcopy; return; fi
  linux_display_env
  if [ "$(session_type)" = wayland ]; then
    if [ -z "$1" ]; then timeout 5 wl-copy --clear; else printf '%s' "$1" | timeout 5 wl-copy; fi
  else
    printf '%s' "$1" | timeout 5 xclip -selection clipboard
  fi
}

cmd_clip_get() {
  if [ "$OS" = Darwin ]; then pbpaste; echo; return; fi
  linux_display_env
  if [ "$(session_type)" = wayland ]; then timeout 5 wl-paste -n; else timeout 5 xclip -selection clipboard -o; fi
  echo
}

cmd_http_start() {
  cmd_http_stop >/dev/null 2>&1 || true
  [ -d "$FIXTURES/site" ] || cmd_fixtures >/dev/null
  nohup python3 -m http.server "$HTTP_PORT" --bind 127.0.0.1 --directory "$FIXTURES/site" > "$SHARE/http.log" 2>&1 < /dev/null &
  echo $! > "$SHARE/http.pid"
  sleep 1
  curl -fsS "http://127.0.0.1:$HTTP_PORT/" | grep -q 'Hello from Muxy E2E' || die "fixture web server did not answer"
  echo "serving http://127.0.0.1:$HTTP_PORT/"
}

cmd_http_stop() {
  [ -f "$SHARE/http.pid" ] && kill "$(cat "$SHARE/http.pid")" 2>/dev/null
  rm -f "$SHARE/http.pid"
  echo "web server stopped"
}

cmd_dialog_fixture() {
  test -f "$SHARE/managed" || die "not a prepared Muxy test guest"
  mkdir -p "$HOME/.local/bin"
  local provider
  for provider in claude codex; do
    if [ ! -e "$HOME/.local/bin/$provider" ]; then
      printf '#!/bin/sh\nexit 125\n' > "$HOME/.local/bin/$provider"
      chmod +x "$HOME/.local/bin/$provider"
    fi
  done
  printf 'dialog fixture change\n' >> "$FIXTURES/alpha/README.md"
  echo "dialog-only AI provider stubs installed; alpha has unstaged changes; cancel every AI confirmation"
}

cmd_symbol_language_fixture() {
  test -f "$SHARE/managed" || die "not a prepared Muxy test guest"
  [ -z "$(app_pid)" ] || die "quit the app before installing the language fixture"
  python3 - <<'PY'
import json, os, re
from pathlib import Path
profile = Path(os.environ['MUXY_DIR'])
name = 'e2e-symbol-language'
root = profile / 'extensions' / name
bundle = root / 'French.bundle'
(bundle / 'fr.lproj').mkdir(parents=True, exist_ok=True)
(root / 'package.json').write_text(json.dumps({
    'name': name, 'version': '1.0.0',
    'muxy': {'localizations': [{'id': 'fr', 'language': 'fr', 'title': 'French symbols fixture', 'bundle': 'French.bundle'}]}
}))
(bundle / 'Info.plist').write_text('<?xml version="1.0"?><plist version="1.0"><dict><key>CFBundleIdentifier</key><string>test.muxy.symbols</string></dict></plist>')
(bundle / 'fr.lproj' / 'Localizable.strings').write_text('"Folder" = "Dossier";\n"Folder Fill" = "Dossier rempli";\n')
enabled = profile / 'extension-enabled.json'
values = json.loads(enabled.read_text()) if enabled.exists() else []
enabled.write_text(json.dumps(sorted(set(values + [name]))))
settings = profile / 'settings.toml'
text = settings.read_text() if settings.exists() else ''
selection = 'language = "e2e-symbol-language:fr"\n'
section = re.search(r'(?ms)^\[appearance\]\s*\n(.*?)(?=^\[|\Z)', text)
if section:
    body = re.sub(r'(?m)^language\s*=.*\n?', '', section[1])
    text = text[:section.start()] + '[appearance]\n' + selection + body + text[section.end():]
else:
    text += '\n[appearance]\n' + selection
settings.write_text(text)
print('resource-only French symbol fixture installed and selected; launch the app')
PY
}

cmd_agent_fixture() {
  test -f "$SHARE/managed" || die "not a prepared Muxy test guest"
  mkdir -p "$HOME/.local/bin"
  local provider
  for provider in claude codex kiro-cli; do
    cat > "$HOME/.local/bin/$provider" <<'STUB'
#!/bin/sh
echo "AGENT-STUB name=$(basename "$0")"
echo "AGENT-ARGS $*"
echo "AGENT-CWD $(pwd)"
echo "AGENT-MUXY $(command -v muxy)"
if muxy extension list >/dev/null 2>&1; then echo "AGENT-CLI ok-$((40+2))"; else echo "AGENT-CLI failed"; fi
sleep 600
STUB
    chmod +x "$HOME/.local/bin/$provider"
  done
  echo "stub agents installed: claude, codex, kiro-cli"
}

# A second server profile in this guest, listed in settings as the remote
# server "devbox" through a custom SSH command, with project beta.
cmd_remote_fixture() {
  test -f "$SHARE/managed" || die "not a prepared Muxy test guest"
  [ -z "$(app_pid)" ] || die "quit the app before adding the remote fixture"
  local profile="$FIXTURES/remote-profile"
  MUXY_DIR="$profile" muxy server stop --force >/dev/null 2>&1 || true
  rm -rf "$profile"
  mkdir -p "$profile"
  MUXY_DIR="$profile" muxy project add "$FIXTURES/beta" >/dev/null || die "could not add beta to devbox"
  python3 - "$profile" "$BIN" <<'PY' || die "could not list devbox in settings.toml"
import os, sys, uuid
from pathlib import Path
profile, binary = sys.argv[1], sys.argv[2]
settings = Path(os.environ['MUXY_DIR']) / 'settings.toml'
command = (
    f'env MUXY_DIR={profile} MUXY_SERVER_BIN={binary}/muxy-server '
    f'PATH={binary}:/usr/bin:/bin sh -c'
)
with settings.open('a') as file:
    file.write(f'\n[[servers]]\nid = "{uuid.uuid4()}"\nname = "devbox"\nssh_command = "{command}"\n')
PY
  echo "devbox listed with project beta; launch the app"
}

