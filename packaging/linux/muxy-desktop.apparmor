# Optional Ubuntu 24.04 integration for WebKitGTK's user-namespace sandbox.
# Install as /etc/apparmor.d/muxy-desktop, then reload with apparmor_parser -r.
# Adapt the attachment path if XDG_DATA_HOME has been customized.
abi <abi/4.0>,
include <tunables/global>

profile muxy-desktop @{HOME}/.local/share/muxy-desktop{,-beta}/versions/*/muxy-app flags=(unconfined) {
    userns,
}

profile muxy-desktop-package /usr/lib/muxy-desktop{,-beta}/muxy-app flags=(unconfined) {
    userns,
}

profile muxy-desktop-appimage @{HOME}/.local/share/muxy-appimage/*/usr/bin/muxy-app flags=(unconfined) {
    userns,
}
