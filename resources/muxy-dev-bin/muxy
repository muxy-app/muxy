#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
CLI_DIRECTORY="$(cd "$SCRIPT_DIR/../Muxy_Muxy.bundle/scripts" && pwd -P)"
readonly CLI_DIRECTORY
readonly CLI="$CLI_DIRECTORY/muxy-cli"
readonly APP_PATH="${MUXY_DEVELOPMENT_APP_PATH:-${MUXY_APP_PATH:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}}"
readonly SOCKET_PATH="${MUXY_DEVELOPMENT_SOCKET_PATH:-${MUXY_SOCKET_PATH:-unavailable}}"
readonly VERSION="${MUXY_DEVELOPMENT_VERSION:-${MUXY_VERSION:-unknown}}"
export MUXY_APP_PATH="$APP_PATH"
export MUXY_SOCKET_PATH="$SOCKET_PATH"

if (($# == 1)); then
    case "$1" in
        version|--version|-V)
            if [[ -S "$SOCKET_PATH" ]]; then
                socket_status=live
            else
                socket_status=missing
            fi
            printf 'Muxy %s\n' "$VERSION"
            printf 'mode: development\n'
            printf 'app: %s\n' "$APP_PATH"
            printf 'cli: %s\n' "$CLI"
            printf 'socket: %s\n' "$SOCKET_PATH"
            printf 'socket-status: %s\n' "$socket_status"
            exit 0
            ;;
    esac
fi
exec "$CLI" "$@"
