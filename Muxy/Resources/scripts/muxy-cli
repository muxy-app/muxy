#!/bin/bash
# Muxy CLI wrapper - Usage: muxy /path/to/project
# Opens a folder in Muxy app

TARGET_DIR="$1"

if [ -z "$TARGET_DIR" ]; then
    echo "Usage: muxy <path>"
    echo "       muxy ."
    exit 1
fi

# Resolve relative paths to absolute
case "$TARGET_DIR" in
    ~*) TARGET_DIR="${HOME}${TARGET_DIR:1}" ;;
    .)  TARGET_DIR="$(pwd)" ;;
    ..) TARGET_DIR="$(cd .. && pwd)" ;;
    *)  TARGET_DIR="$(cd "$TARGET_DIR" 2>/dev/null && pwd)" ;;
esac

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: $TARGET_DIR is not a valid directory"
    exit 1
fi

# Open via URL scheme — works with installed .app bundle
ENCODED=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=':/'))" "$TARGET_DIR")
open "muxy:$ENCODED" 2>/dev/null

# Fallback: send path to running Muxy via its notification socket
SOCKET="$HOME/Library/Application Support/Muxy/muxy.sock"
if [ -e "$SOCKET" ]; then
  echo "open-project|$TARGET_DIR" | nc -U "$SOCKET" 2>/dev/null
fi